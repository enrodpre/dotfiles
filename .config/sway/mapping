# vim:ft=swayconfig

set $mod Mod1
set $up k
set $down j
set $left h
set $right l

## Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
#workspace_auto_back_and_forth yes
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- -l 1.2
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.2

bindsym $mod+c exec --no-startup-id zsh -c 'toggle-sink.sh'
bindsym $mod+Shift+t exec 'systemctl --user restart waybar'
bindsym $mod+Shift+s exec --no-startup-id grimshot --notify copy area
bindsym $mod+Return exec "$TERM_EMULATOR"
bindsym $mod+Shift+Return exec kitten quick-access-terminal 
bindsym $mod+Shift+q kill
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+e layout toggle split
bindsym $mod+Shift+r reload

bindsym $mod+r mode "Resize"
mode "Resize" {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym k resize grow height 10 px or 10 ppt
  bindsym j resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym q mode "default"
}

set $mode_gaps [Kk] Plus [Jj] Minus 
bindsym $mod+g mode "$mode_gaps"

mode "$mode_gaps" {
  bindsym Shift+j gaps inner all minus 20; gaps outer all minus 20
  bindsym j gaps inner all minus 5; gaps outer all minus 5
  bindsym k gaps inner all plus 5; gaps outer all plus 5
  bindsym Shift+k gaps inner all plus 20; gaps outer all plus 20

  bindsym Escape mode "default"
  bindsym Return mode "default"
  bindsym q mode "default"
}

# Rofi
set $ROFI_SCRIPTS $HOME/.config/rofi/scripts
bindsym $mod+x exec $ROFI_SCRIPTS/run
bindsym $mod+p exec $ROFI_SCRIPTS/powermenu

