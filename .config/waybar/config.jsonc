// -*- mode: jsonc -*-
{
	//"output": "DP-3",
	"output": "HDMI-A-1",
	"height": 30, // Waybar height (to be removed for auto height)
	"spacing": 4, // Gaps between modules (4px)
	"modules-left": ["sway/workspaces", "sway/mode"],
	"modules-center": [
		"custom/updates",
		"disk",
		"cpu",
		"memory",
		"temperature",
		"network"
	],
	"modules-right": ["wireplumber", "clock"],
	"custom/updates": {
		"format": "{icon} {text}",
		"return-type": "json",
		"format-icons": {
			"has-updates": "󱍷",
			"updated": "󰂪"
		},
		"exec-if": "which waybar-module-pacman-updates",
		"exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
	},
	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"warp-on-scroll": false,
		"format": "{name}: {icon} ",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"5": "",
			"urgent": "",
			"focused": "",
			"default": ""
		}
	},
	"disk": {
		"format": "󰋊 {percentage_used}%",
		"tootltip-format": "{used} used out of {total}"
	},
	"sway/mode": {
		"format": "<span style=\"italic\">{}</span>"
	},
	"clock": {
		"timezone": "Europe/Madrid",
		"format": "  {:%Y/%m/%d at %H:%M}"
	},
	"cpu": {
		"format": "󰍛 {usage}%",
		"tooltip": false
	},
	"memory": {
		"format": "  {}%"
	},
	"temperature": {
		"hwmon-path": "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon2/temp3_input",
		"critical-threshold": 80,
		"format": "{icon} {temperatureC}°",
		"format-icons": ["", "", "", ""]
	},
	"network": {
		"format-wifi": "󰖩 {ifname}",
		"format-ethernet": "  {bandwidthDownBytes}",
		"tooltip-format": "{ifname} via {gwaddr} ",
		"format-linked": "{ifname} (No IP) ",
		"format-disconnected": "! Disconnected"
	},
	"wireplumber": {
		"format": "{icon}  {node_name} {volume}%",
		"format-muted": "󰝟 {node_name} 0%",
		"format-icons": ["", "", ""],
		"on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "toggle-sink.sh",
		"scroll-step": 5
	}
}
